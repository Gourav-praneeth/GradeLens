# Neon PostgreSQL. Use the pooled URL at runtime and the direct URL for Prisma migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# Upload storage. Production defaults to s3; local development defaults to local.
# Neon Object Storage's tooling writes the standard AWS_* credentials.
STORAGE_DRIVER=s3
# Optional; defaults to the private `uploads` bucket declared in neon.ts.
STORAGE_BUCKET=uploads
# Use the exact region Neon injects, for example us-east-2.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
# Set false only when the provider requires virtual-hosted bucket URLs.
# S3_FORCE_PATH_STYLE=true

# Optional server fallback if a user has not saved a personal key in Account settings.
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Encrypts personal grading keys and Canvas tokens at rest. Required in production.
LLM_KEY_SECRET=

# Optional model overrides
# GROQ_MODEL=openai/gpt-oss-120b
# GRADING_BATCH_SIZE=4
# GRADING_CONCURRENCY=2
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# OPENAI_MODEL=gpt-4o-mini

# Access controls
# SIGNUP_INVITE=
# ALLOW_SIGNUP=true

# Email (Resend). Required on a public URL so signup can verify addresses and forgot-password can send a reset link.
# EMAIL_FROM="GradeLens <noreply@yourdomain.com>"
# RESEND_API_KEY=
# PUBLIC_APP_URL=https://your-service.onrender.com
# FEEDBACK_ADMIN_EMAIL=you@university.edu
