# SQLite. Prisma CLI resolves this next to prisma/schema.prisma.
# The app maps file:./dev.db to prisma/dev.db so Next.js uses the same file.
DATABASE_URL="file:./dev.db"

# Optional server fallback if a user has not saved a personal key in Account settings.
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Encrypts personal API keys at rest. Set a long random string in production.
# LLM_KEY_SECRET=

# Optional model overrides
# GROQ_MODEL=openai/gpt-oss-120b
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# OPENAI_MODEL=gpt-4o-mini

# Production (Railway volume mounted at /data). Leave unset for local dev.
# DATA_DIR=/data
# DATABASE_URL=file:/data/gradelens.db
# UPLOAD_DIR=/data/uploads
# SIGNUP_INVITE=
# ALLOW_SIGNUP=true
