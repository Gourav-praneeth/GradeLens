# SQLite. Prisma CLI resolves this next to prisma/schema.prisma.
# The app maps file:./dev.db to prisma/dev.db so Next.js uses the same file.
DATABASE_URL="file:./dev.db"

# Provide at least one LLM key. Groq is used when it is set (free tier at console.groq.com).
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional model overrides
# GROQ_MODEL=openai/gpt-oss-120b
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# OPENAI_MODEL=gpt-4o-mini
